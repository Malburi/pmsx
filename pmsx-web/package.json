{
  "name": "pmsx-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "predev": "npm run icons",
    "dev": "vite",
    "predev:mock": "npm run icons",
    "dev:mock": "vite --mode mock",
    "prebuild": "npm run icons",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "prebuild:mock": "npm run icons",
    "build:mock": "vue-tsc --noEmit -p tsconfig.app.json && vite build --mode mock",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "audit:high": "npm audit --audit-level=high",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@iconify-json/ri": "1.2.5",
    "@iconify/vue": "5.0.0",
    "@vue-flow/background": "1.3.2",
    "@vue-flow/controls": "1.1.3",
    "@vue-flow/core": "1.48.2",
    "@vue-flow/minimap": "1.5.4",
    "axios": "1.9.0",
    "echarts": "6.1.0",
    "elkjs": "0.11.1",
    "html-to-image": "1.11.11",
    "pinia": "3.0.2",
    "pinia-plugin-persistedstate": "4.3.0",
    "pretendard": "1.3.9",
    "vue": "3.5.13",
    "vue-i18n": "9.14.4",
    "vue-router": "4.5.1",
    "vuetify": "3.13.5"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/eslint-config-typescript": "14.5.0",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.27.0",
    "eslint-plugin-vue": "10.1.0",
    "globals": "16.1.0",
    "jsdom": "26.1.0",
    "sass": "1.89.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.1",
    "unplugin-vue-router": "0.12.0",
    "vite": "5.4.19",
    "vite-plugin-vue-layouts": "0.11.0",
    "vite-plugin-vuetify": "2.1.1",
    "vitest": "3.1.4",
    "vue-tsc": "2.2.10"
  }
}
