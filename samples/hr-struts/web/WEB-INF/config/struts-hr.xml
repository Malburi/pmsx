<?xml version="1.0" encoding="euc-kr"?>
<!DOCTYPE struts-config PUBLIC "-//Apache Software Foundation//DTD Struts Configuration 1.3//EN" "http://struts.apache.org/dtds/struts-config_1_3.dtd">
<struts-config>
  <action-mappings>
    <!-- 사원 관리 (자체 프레임워크 디스패치) -->
    <action path="/hr/emp/EmpAction" type="kr.sample.fw.WorkerAction" name="beanForm" scope="request"
            parameter="method" validate="false" command="EmpService">
      <forward name="list" path="/WEB-INF/jsp/hr/emp/empList.jsp"/>
      <forward name="edit" path="/WEB-INF/jsp/hr/emp/empEdit.jsp"/>
      <forward name="pop" path="/WEB-INF/jsp/hr/emp/empPop.jsp"/>
    </action>
    <!-- 부서 관리 (표준 DispatchAction) -->
    <action path="/hr/dept/DeptAction" type="kr.sample.hr.dept.DeptAction" parameter="method">
      <forward name="list" path="/WEB-INF/jsp/hr/dept/deptList.jsp"/>
    </action>
  </action-mappings>
</struts-config>
