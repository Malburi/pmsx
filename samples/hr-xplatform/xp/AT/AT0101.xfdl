<?xml version="1.0" encoding="utf-8"?>
<FDL version="1.2">
  <TypeDefinition url="..\default_typedef.xml"/>
  <Form id="AT0101" classname="AT0101" inheritanceid="" position="absolute 0 0 1000 600" titletext="근태신청" onload="AT0101_onload">
    <Static id="st_title" text="근태신청" cssclass="sta_WF_title" position="absolute 10 8 300 34"/>
    <Div id="div_search" taborder="0" position="absolute 10 40 990 84">
      <Static id="st_empNm" text="사원명" position="absolute 10 11 60 33"/>
      <Edit id="edt_empNm" taborder="1" position="absolute 64 10 214 34"/>
      <Button id="btn_emp" taborder="2" text="…" position="absolute 216 10 242 34" onclick="btn_emp_onclick"/>
      <Static id="st_type" text="근태구분" position="absolute 270 11 330 33"/>
      <Combo id="cbo_type" taborder="3" innerdataset="ds_type" codecolumn="CODE" datacolumn="CODE_NM" position="absolute 334 10 474 34"/>
      <Button id="btn_search" taborder="4" text="조회" position="absolute 900 9 970 35" onclick="btn_search_onclick"/>
    </Div>
    <Grid id="grd_req" taborder="5" binddataset="ds_req" position="absolute 10 94 990 494" oncelldblclick="grd_req_oncelldblclick">
      <Formats>
        <Format id="default">
          <Columns>
            <Column size="110"/>
            <Column size="100"/>
            <Column size="120"/>
            <Column size="120"/>
            <Column size="200"/>
          </Columns>
          <Rows>
            <Row size="24" band="head"/>
            <Row size="24"/>
          </Rows>
          <Band id="head">
            <Cell text="신청번호"/>
            <Cell col="1" text="사번"/>
            <Cell col="2" text="근태구분"/>
            <Cell col="3" text="일자"/>
            <Cell col="4" text="사유"/>
          </Band>
          <Band id="body">
            <Cell text="bind:REQ_NO"/>
            <Cell col="1" text="bind:EMP_NO"/>
            <Cell col="2" text="bind:ATT_TYPE"/>
            <Cell col="3" text="bind:REQ_DT"/>
            <Cell col="4" text="bind:REASON"/>
          </Band>
        </Format>
      </Formats>
    </Grid>
    <Button id="btn_add" taborder="6" text="추가" position="absolute 760 504 830 530" onclick="btn_add_onclick"/>
    <Button id="btn_save" taborder="7" text="저장" position="absolute 836 504 906 530" onclick="btn_save_onclick"/>
    <Button id="btn_req" taborder="8" text="결재요청" position="absolute 912 504 990 530" onclick="btn_req_onclick"/>
    <Objects>
      <Dataset id="ds_req">
        <ColumnInfo>
          <Column id="REQ_NO" type="STRING" size="20"/>
          <Column id="EMP_NO" type="STRING" size="10"/>
          <Column id="ATT_TYPE" type="STRING" size="10"/>
          <Column id="REQ_DT" type="DATE" size="8"/>
          <Column id="REASON" type="STRING" size="200"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_search">
        <ColumnInfo>
          <Column id="EMP_NM" type="STRING" size="50"/>
          <Column id="ATT_TYPE" type="STRING" size="10"/>
        </ColumnInfo>
      </Dataset>
      <Dataset id="ds_type"/>
    </Objects>
    <Bind>
      <BindItem id="item0" compid="div_search.edt_empNm" propid="value" datasetid="ds_search" columnid="EMP_NM"/>
      <BindItem id="item1" compid="div_search.cbo_type" propid="value" datasetid="ds_search" columnid="ATT_TYPE"/>
    </Bind>
    <Script type="xscript4.0"><![CDATA[include "lib::comLib.xjs";

function AT0101_onload(obj:Form, e:LoadEventInfo)
{
    gfn_getCode("ATT_TYPE", "ds_type");
    fn_search();
}

function fn_search()
{
    transaction("svcSearch", "svc::at/req/selectList.do", "ds_search=ds_search", "ds_req=output", "", "fn_callback");
}

function btn_search_onclick(obj:Button, e:ClickEventInfo)
{
    fn_search();
}

function btn_emp_onclick(obj:Button, e:ClickEventInfo)
{
    gfn_openPopup("empPop", "AT::AT0101P01.xfdl", "", "fn_popCallback");
}

function fn_popCallback(sId, sRtn)
{
    div_search.edt_empNm.value = sRtn;
    fn_search();
}

function btn_add_onclick(obj:Button, e:ClickEventInfo)
{
    ds_req.addRow();
}

function btn_save_onclick(obj:Button, e:ClickEventInfo)
{
    if (!confirm("저장하시겠습니까?")) return;
    gfn_transaction("svcSave", "svc::at/req/save.do", "ds_req=ds_req:U", "", "", "fn_callback");
}

function btn_req_onclick(obj:Button, e:ClickEventInfo)
{
    if (confirm("결재를 요청하시겠습니까?")) {
        transaction("svcReq", "svc::at/req/request.do", "ds_req=ds_req", "", "", "fn_callback");
    }
}

function grd_req_oncelldblclick(obj:Grid, e:GridClickEventInfo)
{
    btn_emp_onclick();
}

function fn_callback(svcId, errCd, errMsg)
{
    if (errCd < 0) { alert(errMsg); return; }
    if (svcId == "svcSave" || svcId == "svcReq") fn_search();
}
]]></Script>
  </Form>
</FDL>
