<?xml version="1.0" encoding="utf-8"?>
<FDL version="2.1">
  <Form id="PY0102" width="1280" height="720" titletext="급여명세" onload="form_onload">
    <Layouts>
      <Layout height="720" width="1280">
        <Static id="sta_title" taborder="0" text="급여명세" left="20" top="10" width="300" height="30" cssclass="sta_WF_title"/>
        <Div id="div_search" taborder="1" left="20" top="50" width="1240" height="50" cssclass="div_WF_search">
          <Layouts>
            <Layout>
              <Static id="sta_ym" taborder="0" text="귀속년월" left="10" top="13" width="70" height="24"/>
              <Calendar id="cal_payYm" taborder="1" left="85" top="13" width="120" height="24" dateformat="yyyy-MM"/>
              <Static id="sta_empNo" taborder="2" text="사번" left="230" top="13" width="40" height="24"/>
              <Edit id="edt_empNo" taborder="3" left="275" top="13" width="120" height="24"/>
            </Layout>
          </Layouts>
        </Div>
        <Button id="btn_search" taborder="2" text="조회" left="1066" top="110" width="60" height="26" onclick="btn_search_onclick"/>
        <Button id="btn_print" taborder="3" text="인쇄" left="1132" top="110" width="60" height="26"/>
        <Button id="btn_mail" taborder="4" text="메일발송" left="1198" top="110" width="62" height="26" onclick="btn_mail_onclick"/>
        <Tab id="tab_detail" taborder="5" left="20" top="142" width="1240" height="540" tabindex="0" onchanged="tab_detail_onchanged">
          <Tabpages>
            <Tabpage id="tpg_allow" text="지급내역">
              <Layouts>
                <Layout>
                  <Grid id="grd_allow" taborder="0" left="10" top="10" width="1210" height="480" binddataset="ds_allow">
                    <Formats>
                      <Format id="default">
                        <Columns><Column size="200"/><Column size="150"/><Column size="300"/></Columns>
                        <Rows><Row size="26" band="head"/><Row size="24"/></Rows>
                        <Band id="head"><Cell text="수당항목"/><Cell col="1" text="금액"/><Cell col="2" text="비고"/></Band>
                        <Band id="body"><Cell text="bind:ITEM_NM"/><Cell col="1" text="bind:AMT"/><Cell col="2" text="bind:RMK"/></Band>
                      </Format>
                    </Formats>
                  </Grid>
                </Layout>
              </Layouts>
            </Tabpage>
            <Tabpage id="tpg_deduct" text="공제내역">
              <Layouts>
                <Layout>
                  <Grid id="grd_deduct" taborder="0" left="10" top="10" width="1210" height="480" binddataset="ds_deduct">
                    <Formats>
                      <Format id="default">
                        <Columns><Column size="200"/><Column size="150"/></Columns>
                        <Rows><Row size="26" band="head"/><Row size="24"/></Rows>
                        <Band id="head"><Cell text="공제항목"/><Cell col="1" text="금액"/></Band>
                        <Band id="body"><Cell text="bind:ITEM_NM"/><Cell col="1" text="bind:AMT"/></Band>
                      </Format>
                    </Formats>
                  </Grid>
                </Layout>
              </Layouts>
            </Tabpage>
          </Tabpages>
        </Tab>
      </Layout>
    </Layouts>
    <Objects>
      <Dataset id="ds_search">
        <ColumnInfo>
          <Column id="PAY_YM" type="STRING" size="6"/>
          <Column id="EMP_NO" type="STRING" size="10"/>
        </ColumnInfo>
        <Rows><Row/></Rows>
      </Dataset>
      <Dataset id="ds_allow">
        <ColumnInfo><Column id="ITEM_NM" type="STRING" size="100"/><Column id="AMT" type="BIGDECIMAL" size="15"/><Column id="RMK" type="STRING" size="200"/></ColumnInfo>
      </Dataset>
      <Dataset id="ds_deduct">
        <ColumnInfo><Column id="ITEM_NM" type="STRING" size="100"/><Column id="AMT" type="BIGDECIMAL" size="15"/></ColumnInfo>
      </Dataset>
    </Objects>
    <Bind>
      <BindItem id="item0" compid="div_search.form.cal_payYm" propid="value" datasetid="ds_search" columnid="PAY_YM"/>
      <BindItem id="item1" compid="div_search.form.edt_empNo" propid="value" datasetid="ds_search" columnid="EMP_NO"/>
    </Bind>
    <Script type="xscript5.1"><![CDATA[
include "Lib::lib_comm.xjs";

this.form_onload = function(obj:nexacro.Form, e:nexacro.LoadEventInfo)
{
    this.gfn_initForm(obj);
    var oArg = this.getOwnerFrame().arguments;
    if (oArg && oArg.empNo) {
        this.ds_search.setColumn(0, "EMP_NO", oArg.empNo);
        this.fn_search();
    }
};

this.fn_search = function()
{
    this.gfn_transaction("selectStmt", "svc::py/stmt/selectStmt.do", "ds_search=ds_search", "ds_allow=ds_allow ds_deduct=ds_deduct", "", "fn_callback");
};

this.btn_search_onclick = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
    this.fn_search();
};

this.tab_detail_onchanged = function(obj:nexacro.Tab, e:nexacro.TabIndexChangeEventInfo)
{
    trace("tab changed: " + e.postindex);
};

/* 명세서 메일 발송 */
this.btn_mail_onclick = function(obj:nexacro.Button, e:nexacro.ClickEventInfo)
{
    if (!this.confirm("급여명세서를 메일로 발송하시겠습니까?")) return;
    this.gfn_transaction("sendMail", "svc::py/stmt/sendMail.do", "ds_search=ds_search", "", "", "fn_callback");
};

this.fn_callback = function(svcId, errCd, errMsg)
{
    if (errCd < 0) this.gfn_alert(errMsg);
};
]]></Script>
  </Form>
</FDL>
